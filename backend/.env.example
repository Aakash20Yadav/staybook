# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored, so your password never reaches the repository.
DB_URL=jdbc:mysql://localhost:3306/hotel_booking?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=hotel_app
DB_PASSWORD=change_me
APP_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:4200
